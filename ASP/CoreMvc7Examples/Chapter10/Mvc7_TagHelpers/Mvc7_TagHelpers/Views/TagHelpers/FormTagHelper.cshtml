@model UserProfile

@{
    ViewData["Title"] = "FormTagHelper";

    int counter = 1;
}

<div class="h-100 p-3 text-white bg-dark rounded-3 mb-4">
    <h2>Form Tag Helper</h2>
</div>


<div class="alert alert-success"><h3>@(counter++). asp-controller & asp-action="PostData" 屬性</h3></div>
<form asp-controller="Person" asp-action="PostData" method="post">
    <div class="form-group">
        <label asp-for="Id" class="control-label"></label>
        <input asp-for="Id" class="form-control" />
        <span asp-validation-for="Id" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Submit" class="btn btn-primary" />
    </div>
</form>

<div class="alert alert-success"><h3>@(counter++). asp-route屬性</h3></div>
<form asp-route="PersonalData" method="post">
    <div class="form-group">
        <label asp-for="Id" class="control-label"></label>
        <input asp-for="Id" class="form-control" />
        <span asp-validation-for="Id" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Submit" class="btn btn-primary" />
    </div>
</form>

<div class="alert alert-success"><h3>@(counter++). asp-route-returnUrl屬性</h3></div>
<form asp-area="Identity" asp-page="/Account/Logout"
      asp-route-returnUrl="@Url.Action("About", "Person", new { area = "" })">
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</form>
