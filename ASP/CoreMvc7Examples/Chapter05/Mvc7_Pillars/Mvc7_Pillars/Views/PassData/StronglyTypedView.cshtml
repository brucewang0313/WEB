@model Employee

@{
    ViewData["Title"] = "StronglyTypedView";

    Employee emp = Model;
}

<div class="h-100 p-3 text-white bg-dark rounded-3">
    <h2>StronglyTypedView</h2>
</div>

<ul>
    <li>@Model.Id</li>
    <li>@Model.Name</li>
    <li>@Model.Phone</li>
    <li>@Model.Email</li>
</ul>

<ul>
    <li>@emp.Id</li>
    <li>@emp.Name</li>
    <li>@emp.Phone</li>
    <li>@emp.Email</li>
</ul>
