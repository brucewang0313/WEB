@model IEnumerable<Card>

@{
    ViewData["Title"] = "View Invoke View Component";
}

<div class="h-100 p-3 text-white bg-dark rounded-3 mb-4">
    <h2>View叫用View Component</h2>
</div>



<h1><span class="badge bg-danger">方法1 - Component.InvokeAsync()方法</span></h1>

<div class="row">
    @*方法1*@
    @await Component.InvokeAsync("CardList", @Model)
</div>



<h1><span class="badge bg-danger">方法2 - Partial Tag Helper</span></h1>
<div class="row">
    @*方法2 - Tag Helper*@
    <vc:card-list data="@Model.ToList()">
    </vc:card-list>
</div>

@section topCSS{
    <link href="~/css/card.css" rel="stylesheet" />
}
