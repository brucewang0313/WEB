@using Microsoft.Extensions.Configuration
@inject IConfiguration config

@{
    string Website = config["Company:Website"];
    string Taipei_Name = config["Company:Branches:Taipei:Name"];
    string Taipei_Tel = config["Company:Branches:Taipei:Tel"];
    string Taichung_Name = config["Company:Branches:Taichung:Name"];
    string Taichung_Tel = config["Company:Branches:Taichung:Tel"];
    string Kaohsiung_Name = config["Company:Branches:Kaohsiung:Name"];
    string Kaohsiung_Tel = config["Company:Branches:Kaohsiung:Tel"];
}

<div class="h-100 p-3 text-white bg-dark rounded-3 mb-4">
    <h2>在View中注入Configuration組態設定</h2>
</div>

<ul>
    <li>公司網站 : @Website</li>
    <li>@Taipei_Name , 電話 : @Taipei_Tel</li>
    <li>@Taichung_Name , 電話 : @Taichung_Tel</li>
    <li>@Kaohsiung_Name , 電話 : @Kaohsiung_Tel</li>
</ul>