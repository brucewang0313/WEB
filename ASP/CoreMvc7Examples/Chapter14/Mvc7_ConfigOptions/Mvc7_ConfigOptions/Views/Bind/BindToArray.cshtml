@model EmployeeViewModel

@{
    ViewData["Title"] = "BindToArray";
}

<div class="h-100 p-3 text-white bg-dark rounded-3 mb-4">
    <h2>將組態繫結至類別的陣列屬性</h2>
</div>

<ul>
    @*@for(int i=0; i<Model.Employees)
    {
        <li></li>
    }*@

    @foreach(var item in Model.Employees)
    {
        <li>@item</li>
    }
</ul>