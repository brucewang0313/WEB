@{
    ViewData["Title"] = "EnvironmentTagHelper";

}

<div class="h-100 p-3 text-white bg-dark rounded-3 mb-4">
    <h1>Environment Tag Helpers</h1>
</div>

<environment include="Development">
    <h2><span class="badge bg-primary">Development開發環境</span></h2>
</environment>

<environment include="Staging">
    <h2><span class="badge bg-danger">Staging開發環境</span></h2>
</environment>

<environment include="Production">
    <h2><span class="badge bg-warning">Production開發環境</span></h2>
</environment>

@section endJS
{
    <environment include="Development">
        <script>
            document.querySelector("h2").addEventListener("click", ()=>{
                alert("This is Development環境")
            })
        </script>
    </environment>

    <environment include="Staging">
        <script>
            document.querySelector("h2").addEventListener("click", ()=>{
                alert("This is Staging環境")
            })
        </script>
    </environment>

    <environment include="Production">
        <script>
            document.querySelector("h2").addEventListener("click", ()=>{
                alert("This is Production環境")
            })
        </script>
    </environment>
}