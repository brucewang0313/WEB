@model dynamic

@{
    ViewData["Title"] = "ObjectInitializerAnonymousType";

        //取得所有Titles的欄位名稱
    var titles = Model.GetType().GetProperties();
}

<h1>ObjectInitializerAnonymousType</h1>

<div>
    <h4>Friend</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @titles[0].Name
        </dt>
        <dd class = "col-sm-10">
            @Model.GetType().GetProperty("Name").GetValue(Model)
        </dd>
        <dt class = "col-sm-2">
            @titles[1].Name
        </dt>
        <dd class = "col-sm-10">
            @Model.GetType().GetProperty("Country").GetValue(Model)
        </dd>
    </dl>
</div>
<div>
    @Html.ActionLink("Edit", "Edit", new { /* id = Model.PrimaryKey */ }) |
    <a asp-action="Index">Back to List</a>
</div>
