@model ProfileViewModel

@{
    ViewData["Title"] = "Profile";

    var Profile = Model;
    var Educations = Model.Educations;
    var Languages = Model.Languages;
    var WorkExperiences = Model.WorkExperiences;
}

<h1>個人履歷表(Profile直白式寫法)</h1>
<h2></h2>

<div class="p-3 mb-2 bg-primary text-white">姓名</div>
<img src="@Profile.Photo" alt="@Profile.Name" />
@Profile.Name


<div class="p-3 mb-2 bg-primary text-white">電子郵件</div>
@Profile.Email

<div class="p-3 mb-2 bg-primary text-white">行動電話</div>
@Profile.Mobile

<div class="p-3 mb-2 bg-primary text-white">簡介</div>
@Profile.Introduction

<div class="p-3 mb-2 bg-primary text-white">教育</div>
<ul>
    @foreach (var edu in Educations)
    {
        <li>@edu.SchoolName, @edu.Department, @edu.StartDate.ToString("yyyy/MM") - @edu.EndDate.ToString("yyyy/MM")</li>
    }
</ul>


<div class="p-3 mb-2 bg-primary text-white">語言</div>
<ul>
    @foreach (var lang in Languages)
    {
        <li>@lang.Name. @lang.Level, @lang.Score</li>
    }
</ul>

<div class="p-3 mb-2 bg-primary text-white">工作經驗</div>
<ul>
    @foreach (var exp in WorkExperiences)
    {
        <li>@exp.Company, @exp.Title, @exp.Salary, @exp.Description, @exp.StartDate.ToString("yyyy/MM") - @exp.EndDate.ToString("yyyy/MM")</li>
    }
</ul>

<div class="p-3 mb-2 bg-primary text-white">JSON</div>
<pre>
    <code>
        @Html.Raw(ViewData["Profile"])
    </code>
</pre>

@section endJS
    {
    <script>
        const profile = @Html.Raw(ViewData["profile"]);

        window.onload = function(){
            document.querySelector("h2").innerText = `${profile.Name}, ${profile.Email}`;
        }

    </script>
}